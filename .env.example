# Copy this file to .env and fill in your values.
# All keys are free-tier. Never commit .env.

# Finnhub (https://finnhub.io — free key, ~60 calls/min).
# Required: news timestamps are label infrastructure for the t0 correction,
# not an optional extra. Fill this in on day one.
FINNHUB_API_KEY=

# SEC EDGAR needs no API key, only a descriptive User-Agent naming you and how
# to reach you — that is the SEC's entire terms of service, and it blocks
# requests that lack one.
#
# This is set here, not in config.yaml, because the repository is PUBLIC: a
# committed address gets scraped, and worse, anyone who forked the project
# would identify as its author to the SEC, so their rate-limit violations
# would land on that author. config.yaml ships a placeholder and the EDGAR
# client refuses to make a live request while that placeholder is all it has.
#
# Format: a project name and a contact address you actually read.
SEC_USER_AGENT=Your Project Name (you@example.com)
