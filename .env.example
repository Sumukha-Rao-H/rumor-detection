# Copy this file to .env and fill in your values.
# All keys are free-tier. Never commit .env.

# Finnhub (https://finnhub.io — free key, ~60 calls/min).
# Required: news timestamps are label infrastructure for the t0 correction,
# not an optional extra. Fill this in on day one.
FINNHUB_API_KEY=

# SEC EDGAR needs no key, only a descriptive User-Agent with a contact
# address. It lives in config.yaml under `http.user_agent` — update it there.
