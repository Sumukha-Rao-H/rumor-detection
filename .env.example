# Copy this file to .env and fill in your values.
# All keys are free-tier. Never commit .env.

# Finnhub (https://finnhub.io — free key, ~60 calls/min) — ground-truth news
FINNHUB_API_KEY=

# Gemini free tier (https://ai.google.dev) — rumor triage + LLM policy baseline
GEMINI_API_KEY=

# Groq free tier (https://console.groq.com) — fallback LLM provider
GROQ_API_KEY=
