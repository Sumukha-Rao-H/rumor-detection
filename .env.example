# Copy this file to .env and fill in your values.
# All keys are free-tier. Never commit .env.

# Finnhub (https://finnhub.io — free key, ~60 calls/min) — ground-truth news
FINNHUB_API_KEY=

# Gemini free tier (https://ai.google.dev) — rumor triage + LLM policy baseline
# Quota is per key (~500 calls/day), so several keys = several daily budgets.
# Any of these three spellings works, and they can be combined:
GEMINI_API_KEY=
# GEMINI_API_KEYS=key_one,key_two,key_three
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# The pool rotates automatically: a key that hits its daily limit sits out
# until midnight Pacific and the run continues on the next one. Check state
# with `python -m src.utils.keypool`.

# Groq free tier (https://console.groq.com) — fallback LLM provider
# Same three spellings (GROQ_API_KEY / GROQ_API_KEYS / GROQ_API_KEY_1..N)
GROQ_API_KEY=
