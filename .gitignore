# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# docs
docs/

# Local working memory for agent sessions (scope, progress, standards).
# Not a deliverable — the committed docs (README, AGENTS.md,
# implementation_plan.md) stay authoritative.
context/

# Virtual env
venv/
.venv/

# Env / secrets
.env

# Data (raw API responses, DB, caches are never committed).
# Ignore files, not directories, so the .gitkeep negation can take effect.
data/**
!data/**/
!data/**/.gitkeep

# ML artifacts
*.pt
*.pth
*.ckpt
*.h5
*.pkl
*.npz
runs/
tensorboard/

# Logs
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
